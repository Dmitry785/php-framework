{
    "name": "dmitry785/php-service",
    "description": "the service that using local-installed php-framework",
	"type": "project",
	"repositories": [
		{
			"type": "path",
			"url": "./packages/php-framework"
		}
	],
	"require": {
		"php": ">=8.2",
        "lukaszzychal/env-loader": "^1.1",
        "dmitry785/php-framework": "@dev"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Dmitry785"
        }
    ],
	"minimum-stability": "dev",
	"prefer-stable": true
}
